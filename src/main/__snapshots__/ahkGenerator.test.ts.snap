// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ahkGenerator > generates hold, once and toggle keystroke macros 1`] = `
"; ==========================================================
; Generated by BINDit - profile: Ankou "Run"
; Do not edit: this file is regenerated every time the engine starts.
; ==========================================================
#NoEnv
#SingleInstance Force
#Persistent
#UseHook On
#MaxHotkeysPerInterval 500
DetectHiddenWindows, On
CoordMode, Mouse, Screen
SetMouseDelay, -1
SetDefaultMouseSpeed, 0
Menu, Tray, Tip, % "BINDit - Ankou ""Run"""

; --- Windows (ahk_pid per account) ---
PID_Psykeeper := 1111  ; Psykeeper
PID_PidTwo := 2222  ; PidTwo
PID_Knight := 0  ; Knight

; --- Macro states ---
M2_On := false

; --- Hotkeys ---
Hotkey, % "$Tab", M0_Down  ; Ankou Run
Hotkey, % "XButton1", M1_Down  ; Mouse 4
Hotkey, % "$NumpadSub", M2_Down, T2  ; Loop RM
Hotkey, % "$F12", FB_StartStop  ; start / stop all macros
FB_Out("RUNNING")
return

FB_Out(msg) {
    FileAppend, %msg%\`n, *
}

SendTo(pid, keys) {
    if (pid && WinExist("ahk_pid " pid))
        ControlSend, , %keys%, ahk_pid %pid%
}

FB_StartStop:
Suspend, Toggle
if (A_IsSuspended) {
    M2_On := false
    SetTimer, M2_Run, Off
    TrayTip, BINDit, Macros stopped, 1
    FB_Out("STOPPED")
} else {
    TrayTip, BINDit, Macros started, 1
    FB_Out("RUNNING")
}
return

; ---- [0] Ankou Run (keys, hold) ----
M0_Run:
SetKeyDelay, 10
SendTo(PID_Psykeeper, "{Blind}{6}{7}")
SendTo(PID_PidTwo, "{Blind}{2}{8}{z}")
SendTo(PID_Knight, "{Blind}{8}{7}")
return

M0_Down:
Loop {
    Gosub, M0_Run
    Sleep, 200
    if (A_IsSuspended || !GetKeyState("Tab", "P"))
        break
}
return

; ---- [1] Mouse 4 (keys, once) ----
M1_Run:
SetKeyDelay, 10
SendTo(PID_PidTwo, "{Blind}{9}{z}")
return

M1_Down:
Gosub, M1_Run
return

; ---- [2] Loop RM (keys, toggle) ----
M2_Run:
SetKeyDelay, 10
SendTo(PID_Psykeeper, "{Blind}{1}{2}{5}")
return

M2_Down:
M2_On := !M2_On
if (M2_On) {
    Gosub, M2_Run
    if (M2_On)
        SetTimer, M2_Run, 400
} else {
    SetTimer, M2_Run, Off
}
return
"
`;
